local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Econ = require(game.ReplicatedStorage.ServiceEcon)
local NumFmt = require(game.ReplicatedStorage.FormatNumber)

local gentime = 2
local barTinfo = TweenInfo.new(gentime, Enum.EasingStyle.Linear)
local pickupTinfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local upgrader = script.Parent
local prompt = upgrader:WaitForChild("ProximityPrompt")
local gui = upgrader:WaitForChild("BillboardGui")

local txtPend = gui.Recoger.TextLabel
local txtPago = gui.Bar.Dinero
local barFill = gui.Bar.BarFill

local pickPart = upgrader:WaitForChild("ParteAnimacionRecoger")

local pickGoal = {
	Size = Vector3.new(10, 1, 10),
	Transparency = 1
}

local pickSize0 = pickPart.Size
local pickTrans0 = pickPart.Transparency

local cobrando = {}
local inited = {}

local function updateUI(plr)
	local pend = plr:GetAttribute("Pendiente") or 0
	local pago = plr:GetAttribute("Pago") or Econ.DEFAULT_PAGO

	txtPend.Text = "$" .. NumFmt.formatNumberDecimals(pend)
	txtPago.Text = "$" .. NumFmt.formatNumberDecimals(pago)
end

local function initPlr(plr)
	if inited[plr] then return end
	inited[plr] = true
	Econ.initPlayer(plr)
	updateUI(plr)
end

local function animBar()
	barFill.Size = UDim2.fromScale(0, 1)

	local t = TweenService:Create(barFill, barTinfo, {
		Size = UDim2.fromScale(1, 1)
	})

	t:Play()
	t.Completed:Wait()

	barFill.Size = UDim2.fromScale(0, 1)
end

prompt.Triggered:Connect(function(plr)
	initPlr(plr)
	if not Econ.canGenerate(plr) then return end

	Econ.startGeneration(plr)

	task.spawn(function()
		animBar()
		Econ.addPendiente(plr)
		Econ.finishGeneration(plr)
		updateUI(plr)
	end)
end)

upgrader.Touched:Connect(function(hit)
	local char = hit.Parent
	if not char then return end

	local hum = char:FindFirstChildWhichIsA("Humanoid")
	if not hum then return end

	local plr = Players:GetPlayerFromCharacter(char)
	if not plr or cobrando[plr] then return end

	initPlr(plr)
	if not Econ.canCollect(plr) then return end

	local stats = plr:FindFirstChild("leaderstats")
	local cash = stats and stats:FindFirstChild("Cash")
	if not cash then return end

	cobrando[plr] = true

	local amount = Econ.collect(plr)
	cash.Value += amount
	updateUI(plr)

	pickPart.Size = pickSize0
	pickPart.Transparency = pickTrans0

	TweenService:Create(pickPart, pickupTinfo, pickGoal):Play()

	task.defer(function()
		cobrando[plr] = nil
	end)
end)

for _, plr in ipairs(Players:GetPlayers()) do
	initPlr(plr)
end

Players.PlayerAdded:Connect(initPlr)
